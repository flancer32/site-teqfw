{
  "name": "@flancer32/site-teqfw",
  "version": "1.0.0",
  "description": "Server-side rendered website application for the TeqFW platform (teqfw.com).",
  "type": "module",
  "license": "Apache-2.0",
  "author": {
    "name": "Alex Gusev",
    "email": "alex@flancer64.com",
    "url": "https://github.com/flancer64"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flancer32/site-teqfw.git"
  },
  "homepage": "https://github.com/flancer32/site-teqfw",
  "bugs": {
    "url": "https://github.com/flancer32/site-teqfw/issues"
  },
  "keywords": [
    "teqfw",
    "tequila-framework",
    "website",
    "ssr",
    "nodejs",
    "dependency-injection",
    "documentation"
  ],
  "types": "types.d.ts",
  "scripts": {
    "start": "teq web:start",
    "test:unit": "find test/unit -name '*.test.mjs' -print0 | xargs -0 node --test",
    "test:integration": "find test/integration -name '*.test.mjs' -print0 | xargs -0 node --test",
    "test": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@teqfw/cfg": "^2.1.0",
    "@teqfw/cli": "^2.3.0",
    "@teqfw/di": "^2.10.0",
    "@teqfw/log": "^2.1.2",
    "@teqfw/web": "^2.1.1",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.12.2"
  },
  "engines": {
    "node": ">=20"
  },
  "teqfw": {
    "fw": {
      "di": {
        "namespaces": [
          {
            "prefix": "TeqFw_Site_",
            "path": "./src",
            "ext": ".mjs"
          }
        ]
      },
      "cli": {
        "plugin": "TeqFw_Site_Cli_Plugin$",
        "command": {
          "default": "web:start"
        }
      }
    }
  }
}
