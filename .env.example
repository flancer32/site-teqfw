# TeqFW web server runtime configuration.
TEQFW_WEB__HOST=127.0.0.1
TEQFW_WEB__PORT=3000
TEQFW_WEB__TLS_CA=
TEQFW_WEB__TLS_CERT=
TEQFW_WEB__TLS_KEY=
TEQFW_WEB__TYPE=http

# Agent-to-human message delivery. Leave SMTP host and sender empty to use the local var/msg fallback.
TEQFW_SITE__AGENT_MAIL_TO=
TEQFW_SITE__AGENT_SMTP_HOST=
TEQFW_SITE__AGENT_SMTP_PORT=465
TEQFW_SITE__AGENT_SMTP_MODE=implicit-tls
TEQFW_SITE__AGENT_SMTP_FROM=
TEQFW_SITE__AGENT_SMTP_USER=
TEQFW_SITE__AGENT_SMTP_PASSWORD=
